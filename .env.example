# Copy to .env and fill in real values. .env is gitignored.
# Get the URI from Atlas: Cluster0 -> Connect -> Drivers.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.ipsbtt1.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=AccountFlow

# HS256 signing key, minimum 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=<generate-me>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
